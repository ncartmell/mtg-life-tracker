# Copy to keystore.properties and fill in. Never commit the real file or the keystore.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.keystore -alias mtg-life-tracker \
#     -keyalg RSA -keysize 4096 -validity 10950
#
# Keep both the keystore and these passwords safe and backed up. Android will only
# install an update over an existing install if it is signed with the same key, so
# losing this means every user has to uninstall before they can upgrade.
storeFile=release.keystore
storePassword=
keyAlias=mtg-life-tracker
keyPassword=
