<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window the system shows before the first frame is drawn. Without it Android
      puts up a blank white rectangle while Compose starts, which on a dark app reads as
      a flash of the wrong colour.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <style name="Theme.App" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
    </style>
</resources>
